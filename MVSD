-- ================== AIMBOT (Silent) ==================
local function getTargetInCircle()
    if not Config.AimbotEnabled then return nil end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest = nil
    local closestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            local head = plr.Character:FindFirstChild("Head")

            if hrp and hum and head and hum.Health > 0 then
                if Config.AimbotTeamCheck then
                    if plr.Team and plr.Team == LocalPlayer.Team then
                        continue
                    end
                end

                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)

                if onScreen then
                    local sp = Vector2.new(screenPos.X, screenPos.Y)
                    local dist = (sp - center).Magnitude

                    if dist <= Config.AimbotRadius then
                        if Config.AimbotWallCheck then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, plr.Character}
                            rayParams.IgnoreWater = true

                            local origin = Camera.CFrame.Position
                            local direction = (head.Position - origin)
                            local result = Workspace:Raycast(origin, direction, rayParams)

                            if result then continue end
                        end

                        if dist < closestDist then
                            closestDist = dist
                            closest = head
                        end
                    end
                end
            end
        end
    end

    return closest
end

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not Config.AimbotEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = getTargetInCircle()
        if target then
            local oldCF = Camera.CFrame
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            task.wait()
            Camera.CFrame = oldCF
        end
    end
end))

