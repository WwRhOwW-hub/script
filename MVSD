-- ================== ESP ==================
local function createESP(plr)
    if plr == LocalPlayer then return end
    if ESPObjects[plr] then return end
    ESPObjects[plr] = {
        highlight = nil, billboard = nil, nameLabel = nil,
        distLabel = nil, healthBar = nil, healthFill = nil,
    }
end

local function removeESP(plr)
    if ESPObjects[plr] then
        if ESPObjects[plr].highlight then pcall(function() ESPObjects[plr].highlight:Destroy() end) end
        if ESPObjects[plr].billboard then pcall(function() ESPObjects[plr].billboard:Destroy() end) end
        ESPObjects[plr] = nil
    end
end

local function updateESP(plr)
    local esp = ESPObjects[plr]
    if not esp then return end

    local char = plr.Character
    if not char then
        if esp.highlight then esp.highlight.Enabled = false end
        if esp.billboard then esp.billboard.Enabled = false end
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    local head = char:FindFirstChild("Head")

    if not (hrp and hum and head and hum.Health > 0) then
        if esp.highlight then esp.highlight.Enabled = false end
        if esp.billboard then esp.billboard.Enabled = false end
        return
    end

    local isEnemy = (plr.Team ~= LocalPlayer.Team) or (plr.Team == nil)
    local show = Config.ESPEnabled
    if Config.ESPTeamCheck and not isEnemy then
        show = false
    end

    if not show then
        if esp.highlight then esp.highlight.Enabled = false end
        if esp.billboard then esp.billboard.Enabled = false end
        return
    end

    if not esp.highlight or esp.highlight.Parent ~= char then
        if esp.highlight then pcall(function() esp.highlight:Destroy() end) end
        local h = Instance.new("Highlight")
        h.Name = "MVSD_ESP"
        h.FillColor = Color3.fromRGB(255, 60, 60)
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.FillTransparency = 0.6
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = char
        esp.highlight = h
    end
    esp.highlight.Enabled = true

    if not esp.billboard or esp.billboard.Parent ~= head then
        if esp.billboard then pcall(function() esp.billboard:Destroy() end) end

        local bb = Instance.new("BillboardGui")
        bb.Name = "MVSD_BB"
        bb.Size = UDim2.new(0, 200, 0, 60)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.Parent = bb

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 18)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        nameLabel.Parent = frame
        esp.nameLabel = nameLabel

        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 0, 14)
        distLabel.Position = UDim2.new(0, 0, 0, 18)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = ""
        distLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        distLabel.TextStrokeTransparency = 0
        distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 12
        distLabel.Parent = frame
        esp.distLabel = distLabel

        local hpBg = Instance.new("Frame")
        hpBg.Size = UDim2.new(0.7, 0, 0, 6)
        hpBg.Position = UDim2.new(0.15, 0, 0, 34)
        hpBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        hpBg.BorderSizePixel = 0
        hpBg.Parent = frame

        local hpBgCorner = Instance.new("UICorner")
        hpBgCorner.CornerRadius = UDim.new(1, 0)
        hpBgCorner.Parent = hpBg

        local hpFill = Instance.new("Frame")
        hpFill.Size = UDim2.new(1, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 80)
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBg

        local hpFillCorner = Instance.new("UICorner")
        hpFillCorner.CornerRadius = UDim.new(1, 0)
        hpFillCorner.Parent = hpFill

        esp.healthBar = hpBg
        esp.healthFill = hpFill
        esp.billboard = bb
    end

    esp.billboard.Enabled = true

    if esp.nameLabel then esp.nameLabel.Visible = Config.ESPShowName end
    if esp.distLabel then
        if Config.ESPShowDistance then
            local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
            esp.distLabel.Text = "[" .. dist .. "m]"
            esp.distLabel.Visible = true
        else
            esp.distLabel.Visible = false
        end
    end

    if esp.healthBar then
        if Config.ESPShowHealth then
            esp.healthBar.Visible = true
            local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            esp.healthFill.Size = UDim2.new(hp, 0, 1, 0)
            if hp > 0.5 then
                esp.healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 80)
            elseif hp > 0.25 then
                esp.healthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                esp.healthFill.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
            end
        else
            esp.healthBar.Visible = false
        end
    end
end

